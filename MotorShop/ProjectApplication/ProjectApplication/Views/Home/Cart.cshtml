@model List<ProjectApplication.Models.CartItemModel>
@{
    ViewBag.Title = "Giỏ Hàng Của Bạn";
    decimal cartTotal = Model?.Sum(item => item.SubTotal) ?? 0;
}
<div class="container mt-4">
    <h2><i class="fas fa-shopping-cart"></i> Giỏ Hàng</h2>
    <hr />

    @if (Model == null || Model.Count == 0)
    {
        <div class="alert alert-warning text-center" role="alert">
            Giỏ hàng của bạn hiện đang trống! 🛒
        </div>
        <p class="text-center">
            @Html.ActionLink("Quay lại mua sắm", "Index", "Home", null, new { @class = "btn btn-info" })
        </p>
    }
    else
    {
        <table class="table table-bordered table-hover">
            <thead class="thead-light">
                <tr>
                    <th>Sản phẩm</th>
                    <th class="text-right">Giá (VNĐ)</th>
                    <th class="text-center">Số lượng</th>
                    <th class="text-right">Tổng cộng (VNĐ)</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @Html.ActionLink(item.ProductName, "Details", "Home", new { id = item.ProductId }, null)
                        </td>
                        <td class="text-right">@string.Format("{0:N0}", item.Price)</td>


                        <td class="text-center">
                            @using (Html.BeginForm("UpdateCartItem", "Home", FormMethod.Post, new { @class = "d-inline-flex" }))
                            {
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="productId" value="@item.ProductId" />

                                <div class="input-group input-group-sm" style="width: 100px;">
                                    <input type="number"
                                           name="newQuantity"
                                           value="@item.Quantity"
                                           min="1"
                                           class="form-control text-center"
                                           onchange="this.form.submit()" />
                                </div>
                            }
                        </td>

                        <td class="text-right">@string.Format("{0:N0}", item.SubTotal)</td>

                        <td>
                            <a href="@Url.Action("RemoveFromCart", "Home", new { productId = item.ProductId })" class="btn btn-danger btn-sm">
                                <i class="fas fa-trash-alt"></i> Xóa
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="3" class="text-right">
                        <strong>Tổng tiền giỏ hàng:</strong>
                    </td>
                    <td class="text-right">
                        <strong>@string.Format("{0:N0}", cartTotal) VNĐ</strong>
                    </td>
                    <td></td>
                </tr>
            </tfoot>
        </table>

        using (Html.BeginForm("PlaceOrder", "Home", FormMethod.Post, new { @class = "form-checkout mt-5" }))
        {
            @Html.AntiForgeryToken()

            <h4 class="mb-4" style="color: #007bff; border-bottom: 2px solid #007bff; padding-bottom: 5px;">
                THÔNG TIN GIAO HÀNG
            </h4>

            <div class="form-group row">
                <label class="col-sm-3 col-form-label">Họ và tên <span class="text-danger">*</span></label>
                <div class="col-sm-9">
                    <input type="text" name="customerName" class="form-control" placeholder="Nguyễn Văn A" required />
                </div>
            </div>

            <div class="form-group row">
                <label class="col-sm-3 col-form-label">Số điện thoại <span class="text-danger">*</span></label>
                <div class="col-sm-9">
                    <input type="tel" name="phone" class="form-control"
                           placeholder="0901 234 567"
                           pattern="[0-9]{10,12}"
                           title="Số điện thoại phải chứa 10-12 chữ số"
                           required />
                </div>
            </div>

            <div class="form-group row">
                <label class="col-sm-3 col-form-label">Tỉnh/Thành Phố<span class="text-danger">*</span></label>
                <div class="col-sm-9">
                    <select name="province" class="form-control" required>
                        <option value="">Vui lòng chọn Tỉnh/Thành Phố</option>
                    </select>
                </div>
            </div>

            <div class="form-group row">
                <label class="col-sm-3 col-form-label">Quận/Huyện <span class="text-danger">*</span></label>
                <div class="col-sm-9">
                    <select name="district" class="form-control" required>
                        <option value="">Vui lòng chọn Quận/Huyện</option>
                    </select>
                </div>
            </div>

            <div class="form-group row">
                <label class="col-sm-3 col-form-label">Phường/Xã <span class="text-danger">*</span></label>
                <div class="col-sm-9">
                    <select name="ward" class="form-control" required>
                        <option value="">Vui lòng chọn Phường/Xã</option>
                    </select>
                </div>
            </div>

            <div class="form-group row">
                <label class="col-sm-3 col-form-label">Địa chỉ (số nhà, đường) <span class="text-danger">*</span></label>
                <div class="col-sm-9">
                    <input type="text" name="addressDetail" class="form-control" placeholder="(số nhà, tên đường/ngõ...)" required />
                </div>
            </div>

            <div class="form-group row">
                <label class="col-sm-3 col-form-label">Ghi chú</label>
                <div class="col-sm-9">
                    <textarea name="notes" class="form-control" rows="3" placeholder="Ghi chú thêm nếu có"></textarea>
                </div>
            </div>

            <div class="form-group row mt-4">
                <div class="col-sm-9 offset-sm-3">
                    <button type="submit" class="btn btn-info">
                        GỬI ĐƠN HÀNG
                    </button>
                    @Html.ActionLink("Tiếp tục mua sắm", "Index", "Home", null, new { @class = "btn btn-info" })
                </div>
            </div>
        }
    }
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // --- TOAST --- THÔNG BÁO ---
            var successMessage = '@TempData["SuccessMessage"]';

            if (successMessage && successMessage.length > 0) {
                successMessage = successMessage.replace(/&quot;/g, '"').replace(/&#39;/g, "'");

                var toastHtml = `
                    <div class="toast bg-success text-white text-center" role="alert" aria-live="assertive" aria-atomic="true" data-delay="1500">
                        <div class="toast-body">
                            <strong>Thành công!</strong> ${successMessage}
                        </div>
                    </div>`;
                $('#toast-container').append(toastHtml);
                var newToast = $('#toast-container').find('.toast:last');
                newToast.toast({
                    delay: 1500
                }).toast('show');
            }

            // --- AJAX ĐỊA CHỈ (Tỉnh/Huyện/Xã) ---

            var provinceSelect = $('select[name="province"]');
            var districtSelect = $('select[name="district"]');
            var wardSelect = $('select[name="ward"]');

            // Hàm tải dữ liệu chung
            function loadData(url, parentId, targetSelect, defaultOptionText) {
                targetSelect.empty().append('<option value="">' + defaultOptionText + '</option>').prop('disabled', true);

                var shouldLoad = !parentId || (parentId && url.includes('GetDistricts')) || (parentId && url.includes('GetWards'));

                if (url.includes('GetProvinces') || parentId) {

                    $.ajax({
                        url: url,
                        type: 'GET',
                        data: parentId ? { parentId: parentId } : null,
                        dataType: 'json',
                        success: function (data) {
                            if (data && data.length > 0) {
                                if (data[0].Id === "Error") {
                                    targetSelect.append($('<option></option>').attr('value', data[0].Id).text(data[0].Name));
                                } else {
                                    $.each(data, function (key, entry) {
                                        targetSelect.append($('<option></option>').attr('value', entry.Id).text(entry.Name));
                                    });
                                }
                            }
                            targetSelect.prop('disabled', false);
                        },
                        error: function (xhr, status, error) {
                            console.error("Không thể tải dữ liệu từ: " + url, error);
                            targetSelect.prop('disabled', false);
                        }
                    });
                }
            }

            // A. Tải Tỉnh/Thành khi trang load
            loadData('@Url.Action("GetProvinces", "Home")', null, provinceSelect, 'Vui lòng chọn Tỉnh/Thành');

            // B. Xử lý khi chọn Tỉnh/Thành
            provinceSelect.change(function () {
                var provinceId = $(this).val();
                wardSelect.empty().append('<option value="">Vui lòng chọn Phường/Xã</option>').prop('disabled', true);
                if (provinceId) {
                    loadData('@Url.Action("GetDistricts", "Home")', provinceId, districtSelect, 'Vui lòng chọn Quận/Huyện');
                } else {
                    districtSelect.prop('disabled', true);
                }
            });

            // C. Xử lý khi chọn Quận/Huyện
            districtSelect.change(function () {
                var districtId = $(this).val();
                if (districtId) {
                    loadData('@Url.Action("GetWards", "Home")', districtId, wardSelect, 'Vui lòng chọn Phường/Xã');
                } else {
                    wardSelect.prop('disabled', true);
                }
            });
        });
    </script>
}