@model ProjectApplication.Models.ProductViewModel

@{
    ViewBag.Title = "Chi tiết sản phẩm: " + Model.Name;
}

<div class="container mt-4">

    <h2>Chi tiết sản phẩm</h2>
    <p><b>Mã:</b> @Model.Id</p>
    <p><b>Tên:</b> @Model.Name</p>
    <p><b>Giá:</b> @string.Format("{0:N0} VNĐ", Model.Price)</p>
    <p><b>Loại:</b> @Model.ProductType</p>


    @if (Model.ProductType == "Vehicle")
    {
        <p><b>Động cơ:</b> @Model.Engine</p>
        <p><b>Dung tích:</b> @Model.fuelCapacity</p>
        <p><b>Trọng lượng:</b> @Model.weight</p>
        <p><b>Màu:</b> @Model.Color</p>
        <p><b>Mô tả:</b> @Model.description</p>
    }
    else if (Model.ProductType == "SparePart")
    {
        <p><b>Mô tả:</b> @Model.spareDescription</p>
        <p><b>Phù hợp với:</b> @Model.CompatibleModel</p>
    }

    <hr />

    <div class="product-actions mt-4 d-flex align-items-center">

        @using (Html.BeginForm("AddToCart", "Home", FormMethod.Post, new { @class = "mr-3" }))
        {
            @Html.AntiForgeryToken()
            <input type="hidden" name="productId" value="@Model.Id" />
            <input type="hidden" name="quantity" value="1" />
            <input type="hidden" name="buyNow" value="false" />

            <button type="submit" class="btn btn-primary">
                <i class="fas fa-cart-plus"></i> Thêm vào giỏ
            </button>
        }

        @using (Html.BeginForm("AddToCart", "Home", FormMethod.Post, new { @class = "mr-3" }))
        {
            @Html.AntiForgeryToken()
            <input type="hidden" name="productId" value="@Model.Id" />
            <input type="hidden" name="quantity" value="1" />
            <input type="hidden" name="buyNow" value="true" />

            <button type="submit" class="btn btn-primary">
                <i class="fas fa-credit-card"></i> Mua ngay
            </button>
        }

        <button onclick="window.history.back()" class="btn btn-primary">
            Quay lại
        </button>
    </div>

</div>

@section Scripts {
    <script>
        $(document).ready(function () {

            var successMessage = '@TempData["SuccessMessage"]';

            if (successMessage && successMessage.length > 0) {

                successMessage = successMessage.replace(/&quot;/g, '"').replace(/&#39;/g, "'");

                var toastHtml = `
                    <div class="toast bg-success text-white text-center" role="alert" aria-live="assertive" aria-atomic="true" data-delay="1500">
                        <div class="toast-body">
                            <strong>Thành công!</strong> ${successMessage}
                        </div>
                    </div>`;
                $('#toast-container').append(toastHtml);
                var newToast = $('#toast-container').find('.toast:last');
                newToast.toast({
                    delay: 1500
                }).toast('show');
            }
        });
    </script>
}