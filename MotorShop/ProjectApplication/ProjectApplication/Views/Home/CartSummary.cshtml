@{
    int count = (int?)ViewBag.CartCount ?? 0;
}

<li class="nav-item">
    <a class="nav-link" href="@Url.Action("Cart", "Home")">
        <i class="fas fa-shopping-cart"></i> Giỏ Hàng
        @if (count > 0)
        {
            <span class="badge badge-pill badge-danger">@count</span>
        }
    </a>
</li>
