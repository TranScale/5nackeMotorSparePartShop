@model ProjectApplication.Models.DiscountViewModel

@{
    ViewBag.Title = "Chi tiết giảm giá";
}

<h2 class="mb-3">Chi tiết giảm giá</h2>

<div class="card shadow-sm p-4">
    <dl class="row mb-0">
        <dt class="col-sm-3 fw-bold">Tên chương trình</dt>
        <dd class="col-sm-9">@Model.Name</dd>

        <dt class="col-sm-3 fw-bold">Ngày bắt đầu</dt>
        <dd class="col-sm-9">@Model.dateStart.ToString("dd/MM/yyyy")</dd>

        <dt class="col-sm-3 fw-bold">Ngày kết thúc</dt>
        <dd class="col-sm-9">@Model.dateEnd.ToString("dd/MM/yyyy")</dd>

        <dt class="col-sm-3 fw-bold">Loại khuyến mãi</dt>
        <dd class="col-sm-9">
            @if (Model.discountType == ProjectApplication.Models.DiscountType.Coupon)
            {
                <span class="badge bg-info text-dark">Mã giảm giá</span>
            }
            else
            {
                <span class="badge bg-success">Khuyến mãi</span>
            }
        </dd>

        <dt class="col-sm-3 fw-bold">Giá trị khuyến mãi</dt>
        <dd class="col-sm-9">
            @if (Model.discountValueType == ProjectApplication.Models.DiscountValueType.Percent)
            {
                @($"{Model.discountValue}%")
            }
            else
            {
                @($"{Model.discountValue:N0} ₫")
            }
        </dd>

        @if (Model.discountType == ProjectApplication.Models.DiscountType.Coupon)
        {
            <dt class="col-sm-3 fw-bold">Mã giảm giá</dt>
            <dd class="col-sm-9">@Model.couponCode</dd>
        }
        else if (Model.discountType == ProjectApplication.Models.DiscountType.Promotion)
        {
            <dt class="col-sm-3 fw-bold">Mô tả khuyến mãi</dt>
            <dd class="col-sm-9">@Model.promotionDescription</dd>
        }

        <dt class="col-sm-3 fw-bold">Trạng thái</dt>
        <dd class="col-sm-9">
            @if (Model.isActive)
            {
                <span class="badge bg-success">Đang hoạt động</span>
            }
            else
            {
                <span class="badge bg-secondary">Ngừng hoạt động</span>
            }
        </dd>
    </dl>
</div>

<div class="mt-3">
    @using (Html.BeginForm("DeleteConfirmed", "DiscountManager", FormMethod.Post, new { id = "deleteForm" }))
    {
        @Html.AntiForgeryToken()
        @Html.Hidden("id",Model.Id)
        <button type="button" class="btn btn-danger" onclick="confirmDelete()">
            🗑️ Xóa
        </button>
    }


    @Html.ActionLink("✏️ Chỉnh sửa", "Edit", new { id = Model.Id }, new { @class = "btn btn-warning" })
    @Html.ActionLink("⬅️ Quay lại", "Index", null, new { @class = "btn btn-secondary ms-2" })
</div>

@section Scripts {
    <script>
        function confirmDelete() {
            if (confirm("Bạn có chắc chắn muốn xóa chương trình này không?")) {
                document.getElementById("deleteForm").submit();
            }
        }
    </script>
}