@model ProjectApplication.Models.ProductViewDetail

@{
    ViewBag.Title = "Chi tiết sản phẩm";
}

<h2 class="mb-3">Chi tiết sản phẩm</h2>

<div class="card shadow-sm p-4">
    <dl class="row mb-0">
        <dt class="col-sm-3 fw-bold">Mã sản phẩm</dt>
        <dd class="col-sm-9">@Model.ProductId</dd>

        <dt class="col-sm-3 fw-bold">Tên sản phẩm</dt>
        <dd class="col-sm-9">@Model.ProductName</dd>

        <dt class="col-sm-3 fw-bold">Hãng</dt>
        <dd class="col-sm-9">@Model.BrandName</dd>

        <dt class="col-sm-3 fw-bold">Giá</dt>
        <dd class="col-sm-9">@($"{Model.ProductPrice:N0} ₫")</dd>

        <dt class="col-sm-3 fw-bold">Loại sản phẩm</dt>
        <dd class="col-sm-9">
            <span class="badge bg-info text-dark">@Model.ProductType</span>
        </dd>

        <dt class="col-sm-3 fw-bold">Mô tả sản phẩm</dt>
        <dd class="col-sm-9">@Model.ProductDescription</dd>

        <dt class="col-sm-3 fw-bold">Số lượng còn lại</dt>
        <dd class="col-sm-9">@Model.ProductQuantity</dd>

        @if (Model.ProductType == "Vehicle" || Model.VehicleType != null)
        {
            <hr class="my-3" />
            <h5 class="text-primary fw-bold">Thông tin xe</h5>

            <dt class="col-sm-3 fw-bold">Loại xe</dt>
            <dd class="col-sm-9">@Model.VehicleType</dd>

            <dt class="col-sm-3 fw-bold">Động cơ</dt>
            <dd class="col-sm-9">@($"{Model.Engine} cc")</dd>

            <dt class="col-sm-3 fw-bold">Dung tích xăng</dt>
            <dd class="col-sm-9">@($"{Model.FuelCapacity}l")</dd>

            <dt class="col-sm-3 fw-bold">Màu xe</dt>
            <dd class="col-sm-9">@Model.Color</dd>
        }
        @if (Model.ProductType == "SparePart")
        { }
    </dl>
</div>

<div class="mt-3">
    @using (Html.BeginForm("DeleteConfirmed", "ProductManager", FormMethod.Post, new { id = "deleteForm" }))
    {
        @Html.AntiForgeryToken()
        @Html.Hidden("id", Model.ProductId)
        <button type="button" class="btn btn-danger" onclick="confirmDelete()">
            🗑️ Xóa
        </button>
    }

    <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#addItemModal">
        ➕ Thêm hàng
    </button>

    @Html.ActionLink("✏️ Chỉnh sửa", "Edit", new { id = Model.ProductId }, new { @class = "btn btn-warning" })

    @Html.ActionLink("⬅️ Quay lại", "Index", null, new { @class = "btn btn-secondary ms-2" })
</div>

<!-- Modal Thêm hàng -->
<div class="modal fade" id="addItemModal" tabindex="-1" aria-labelledby="addItemModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addItemModalLabel">Thêm hàng cho sản phẩm</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>

            @using (Html.BeginForm("AddItem", "ProductManager", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.Hidden("productId", Model.ProductId)
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Số lượng muốn thêm</label>
                        <input type="number" name="quantity" id="quantityInput" class="form-control" value="1" min="1" required />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Giá sản phẩm</label>
                        <p>@($"{Model.ProductPrice:N0} ₫")</p>
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Tổng giá</label>
                        <p id="totalPrice" class="fw-bold text-primary">@($"{Model.ProductPrice:N0} ₫")</p>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-success">Xác nhận</button>
                </div>
            }
        </div>
    </div>
</div>


@section Scripts {
    <script>
        function confirmDelete() {
            if (confirm("Bạn có chắc chắn muốn xóa sản phẩm này không?")) {
                document.getElementById("deleteForm").submit();
            }
        }
        const price = @Model.ProductPrice;
        const qtyInput = document.getElementById('quantityInput');
        const totalPrice = document.getElementById('totalPrice');

        qtyInput.addEventListener('input', () => {
            const qty = parseInt(qtyInput.value) || 0;
            totalPrice.textContent = (price * qty).toLocaleString('vi-VN') + ' ₫';
        });
    </script>
}
