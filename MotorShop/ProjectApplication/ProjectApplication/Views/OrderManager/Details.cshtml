@model ProjectApplication.Models.OrderViewDetails

@{
    ViewBag.Title = "Chi tiết đơn hàng";
}

<h2 class="mb-3">Chi tiết đơn hàng #@Model.OrderId</h2>

<div class="card shadow-sm p-4">
    <dl class="row mb-0">
        <dt class="col-sm-3 fw-bold">Tên khách hàng</dt>
        <dd class="col-sm-9">@Model.CustomerName</dd>

        <dt class="col-sm-3 fw-bold">Số điện thoại</dt>
        <dd class="col-sm-9">@Model.Phone</dd>

        <dt class="col-sm-3 fw-bold">Địa chỉ</dt>
        <dd class="col-sm-9">
            @($"{Model.AddressDetail}, {Model.Ward}, {Model.District}, {Model.Province}")
        </dd>

        <dt class="col-sm-3 fw-bold">Ghi chú</dt>
        <dd class="col-sm-9">@(string.IsNullOrEmpty(Model.Notes) ? "(Không có)" : Model.Notes)</dd>

        <dt class="col-sm-3 fw-bold">Ngày đặt hàng</dt>
        <dd class="col-sm-9">@Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</dd>

        <dt class="col-sm-3 fw-bold">Tổng tiền</dt>
        <dd class="col-sm-9 fw-bold text-danger">@($"{Model.TotalAmount:N0} ₫")</dd>

        <dt class="col-sm-3 fw-bold">Trạng thái</dt>
        <dd class="col-sm-9">
            @{
                var badgeClass = "bg-secondary";

                if (Model.Status == "Pending")
                {
                    badgeClass = "bg-warning text-dark";
                }
                else if (Model.Status == "Processing")
                {
                    badgeClass = "bg-info text-dark";
                }
                else if (Model.Status == "Delivered")
                {
                    badgeClass = "bg-success";
                }
            }
            <span class="badge @badgeClass">@Model.Status</span>
        </dd>

    </dl>
</div>

<hr />

<h4 class="mt-4">Danh sách sản phẩm</h4>
<table class="table table-bordered table-striped mt-2">
    <thead class="table-light">
        <tr>
            <th>Mã SP</th>
            <th>Tên sản phẩm</th>
            <th>Số lượng</th>
            <th>Đơn giá (₫)</th>
            <th>Thành tiền (₫)</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Item)
        {
            <tr>
                <td>@item.ProductId</td>
                <td>@item.ProductName</td>
                <td>@item.Quantity</td>
                <td>@item.Price.ToString("N0")</td>
                <td class="fw-bold">@item.SubTotal.ToString("N0")</td>
            </tr>
        }
    </tbody>
</table>

<div class="mt-3">
    @if (Model.Status == "Pending")
    {
        <form action="@Url.Action("MarkAsProcessing", "OrderManager", new { id = Model.OrderId })" method="post" style="display:inline;">
            <button type="submit" class="btn btn-success me-1">✅ Xác nhận đơn</button>
        </form>

        <form action="@Url.Action("CancelOrder", "OrderManager", new { id = Model.OrderId })" method="post" style="display:inline;" onsubmit="return confirmCancel();">
            <button type="submit" class="btn btn-danger">❌ Hủy</button>
        </form>
    }
    else if (Model.Status == "Processing")
    {
        <form action="@Url.Action("MarkAsDelivered", "OrderManager", new { id = Model.OrderId })" method="post" style="display:inline;">
            <button type="submit" class="btn btn-primary">📦 Đánh dấu đã giao</button>
        </form>
    }
    else if (Model.Status == "Cancelled")
    {
        <span class="badge bg-danger me-2">Đơn hàng đã bị hủy</span>
    }

    @Html.ActionLink("⬅️ Quay lại", "Index", null, new { @class = "btn btn-secondary ms-2" })
</div>

@section Scripts {
    <script>
        function confirmCancel() {
            return confirm("Bạn có chắc chắn muốn hủy đơn hàng này không?");
        }
    </script>
}


