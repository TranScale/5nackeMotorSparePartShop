@model IEnumerable<ProjectApplication.Models.ProductViewModel>
@{
    Layout = "~/Views/Shared/_Layout.cshtml"; // Thay bằng layout của bạn
}

<h2>Quản lý cửa hàng</h2>

<button id="btnManagerProduct" class="btn btn-primary mb-2 ml-2">Quản lý sản phẩm</button>
<button id="btnOther" class="btn btn-primary mb-2 ml-2">Hành động khác</button>

<h2>Danh sách sản phẩm</h2>
<button id="btnAdd" class="btn btn-primary mb-2 ml-2">Thêm sản phẩm mới</button>
<form method="get" action="@Url.Action("ProductManage", "ShopManager")">
    <label>Chọn loại sản phẩm: </label>
    <select name="productType" onchange="this.form.submit()" class="form-control">
        <option value="All" @(Request["productType"] == "All" || string.IsNullOrEmpty(Request["productType"]) ? "selected" : "")> Tất cả </option>
        <option value="Vehicle" @(Request["productType"] == "Vehicle" ? "selected" : "")>Vehicle</option>
        <option value="SparePart" @(Request["productType"] == "SparePart" ? "selected" : "")>Spare Part</option>
    </select>
</form>

<table class="table">
    <thead>
        <tr>
            <th>Tên</th>
            <th>Giá</th>
            <th>Loại</th>
            <th>Thông tin</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.ActionLink(item.Name, "Details", "ShopManager", new { id = item.Id }, null)
                </td>
                <td>@item.Price</td>
                <td>@item.ProductType</td>
                <td>
                    @if (item.ProductType == "Vehicle")
                    {
                        <span>Động cơ: @item.Engine</span>
                    }
                    else if (item.ProductType == "SparePart")
                    {
                    }
                </td>
            </tr>
        }
    </tbody>
</table>


@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function () {
            // Điều hướng đến productmanage khi nhấn nút
            $("#btnManagerProduct").click(function () {
                window.location.href = '@Url.Action("productmanage", "ShopManager")';
            });

            // Điều hướng khi chọn loại sản phẩm
            $("#ddlProductType").change(function () {
                var type = $(this).val();
                window.location.href = '@Url.Action("productmanage", "ShopManager")' + '?productType=' + type;
            });
            //Khi chọn btnAdd (thêm sản phẩm)
            $("#btnAdd").click(function () {
                window.location.href = '@Url.Action("Create", "ShopManager")';
            });
        });
    </script>
}
