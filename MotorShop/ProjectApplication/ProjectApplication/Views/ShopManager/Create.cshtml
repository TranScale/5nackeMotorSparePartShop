@{
    ViewBag.Title = "Create Product";
}

<h2>Create Product</h2>

<div class="form-group">
    <label for="productType">Chọn loại sản phẩm</label>
    <select id="productType" class="form-control">
        <option value="">-- Chọn loại --</option>
        <option value="Vehicle">Vehicle</option>
        <option value="SparePart">Spare Part</option>
    </select>
</div>

<!-- Đây là nơi partial view sẽ load -->
<div id="dynamicForm"></div>

@section Scripts {
    <script src="~/Scripts/jquery-3.7.0.min.js"></script>
    <script>
        $(document).ready(function () {
            $("#productType").change(function () {
                var type = $(this).val();
                if (type) {
                    $.get('@Url.Action("LoadFormCreate", "ShopManager")', { productType: type }, function (data) {
                        $("#dynamicForm").html(data);
                    }).fail(function (xhr) {
                        alert("Error: " + xhr.status + " " + xhr.statusText);
                    });
                } else {
                    $("#dynamicForm").html("");
                }
            });
        });
    </script>
}
