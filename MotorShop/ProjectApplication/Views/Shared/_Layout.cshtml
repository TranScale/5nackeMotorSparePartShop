<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - My ASP.NET Application</title>
    <link href="@Url.Content("~/Content/style.css")" rel="stylesheet" />

    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-light bg-light">
        <div class="container px-4 px-lg-5">
            <a class="navbar-brand" href="@Url.Action("Index", "Home")">
               <img src="~/Content/ViewsImages/logo.png" alt="5nakes Shop" style="height:60px;" />
                5nakes Shop
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent"
                    aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarSupportedContent">
                @{
                    // Lấy tên Controller hiện tại
                    var currentController = ViewContext.RouteData.Values["Controller"].ToString();
                }

                @if (currentController == "Home")
                {
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4">
                        <li class="nav-item">
                            @Html.ActionLink("Trang chủ", "Index", "Home", null, new { @class = "nav-link active" })
                        </li>
                        <li class="nav-item">
                            @Html.ActionLink("Giới thiệu", "About", "Home", null, new { @class = "nav-link" })
                        </li>
                    </ul>

                    <form class="d-flex">
                        <a class="btn btn-outline-dark" href="@Url.Action("Cart", "Home")">
                            <i class="bi-cart-fill me-1"></i>
                            Giỏ hàng
                        </a>
                    </form>
                }
            </div>
        </div>
    </nav>


    <div class="container body-content">
        @RenderBody()
        <hr />
        <footer class="py-5 bg-dark text-white">
            <div class="container">
                <div class="row text-center text-md-start">
                    <!-- Cột 1: Tổng đài hỗ trợ -->
                    <div class="col-md-4 mb-3">
                        <h5 class="fw-bold">Tổng đài hỗ trợ</h5>
                        <p>Gọi mua: <a href="tel:0908748439" class="text-white">090 8748439</a> (8:00 - 21:30)</p>
                        <p>Khiếu nại: <a href="tel:0898445830" class="text-white">089 8445830</a> (8:00 - 21:30)</p>
                        <p>Bảo hành: <a href="tel:0764440012" class="text-white">076 4440012</a> (8:00 - 21:00)</p>

                        <p class="mt-3">
                            <a href="/Login/Login" class="text-white-50 text-decoration-underline">
                                Nếu bạn là Quản trị viên?
                            </a>
                        </p>
                    </div>

                    <!-- Cột 2: Địa chỉ cửa hàng -->
                    <div class="col-md-4 mb-3">
                        <h5 class="fw-bold">Địa chỉ cửa hàng</h5>

                        <!-- Chi nhánh Hà Nội -->
                        <p class="fw-semibold">Chi nhánh Hà Nội</p>
                        <p>123 Đường Lê Duẩn, Phường Bến Nghé, Quận 1</p>
                        <p>Điện thoại: <a href="tel:0901234567" class="text-white">090 1234567</a></p>
                        <p>Email: <a href="mailto:hanoi@5nakes.com" class="text-white">hanoi@5nakes.com</a></p>

                        <hr class="border-light my-2" />

                        <!-- Chi nhánh TP. Hồ Chí Minh -->
                        <p class="fw-semibold">Chi nhánh TP. HCM</p>
                        <p>456 Đường Nguyễn Huệ, Phường Bến Nghé, Quận 1</p>
                        <p>Điện thoại: <a href="tel:0907654321" class="text-white">090 7654321</a></p>
                        <p>Email: <a href="mailto:hcm@5nakes.com" class="text-white">hcm@5nakes.com</a></p>
                    </div>

                    <!-- Cột 3: Ủy quyền Yamaha & Honda -->
                    <div class="col-md-4 mb-3">
                        <h5 class="fw-bold">Được ủy quyền bởi</h5>
                        <p>Yamaha Việt Nam</p>
                        <p>Honda Việt Nam</p>
                        <div class="d-flex justify-content-center justify-content-md-start mt-2">
                            <img src="~/Content/ViewsImages/yamahalogo.png" alt="Yamaha" style="height:40px; margin-right:10px;" />
                            <img src="~/Content/ViewsImages/hondalogo.png" alt="Honda" style="height:40px;" />
                        </div>
                    </div>
                </div>

                <hr class="border-light" />

                <p class="m-0 text-center">&copy; @DateTime.Now.Year - 5nakes Shop</p>
            </div>
        </footer>


    </div>

    <div id="toast-container" aria-live="polite" aria-atomic="true"
         style="position: fixed !important;
            top: 20px !important;
            left: 50% !important;
            transform: translateX(-50%) !important;
            z-index: 1050 !important;
            min-width: 300px !important;">
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
            crossorigin="anonymous">
    </script>
    <script>
$(document).on('click', '#btnAddToCart', function () {
    var productId = $(this).data('id');
    $.post('@Url.Action("AddToCart", "Home")', { productId: productId, quantity: 1, buyNow: false }, function (res) {
        if (res && res.count !== undefined) {
            $('#cartCount').text(res.count); // ✅ cập nhật số hiển thị
        }
    });
});
    </script>
</body>
</html>



