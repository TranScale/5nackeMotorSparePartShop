@model IEnumerable<ProjectApplication.Models.OrderViewIndex>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewBag.Title = "Quản lý đơn hàng";
}

<form method="get" class="row g-3 mb-4">
    <div class="col-md-3">
        <label for="startDate" class="form-label">Từ ngày</label>
        <input type="date" name="startDate" id="startDate" value="@ViewBag.StartDate" class="form-control" />
    </div>
    <div class="col-md-3">
        <label for="endDate" class="form-label">Đến ngày</label>
        <input type="date" name="endDate" id="endDate" value="@ViewBag.EndDate" class="form-control" />
    </div>
    <div class="col-md-3 d-flex align-items-end">
        <button type="submit" class="btn btn-primary me-2">Lọc</button>
        <a href="@Url.Action("Index", "OrderManager")" class="btn btn-secondary">Làm mới</a>
    </div>
</form>

<!-- 🧾 Danh sách đơn hàng -->
<table class="table table-bordered table-striped align-middle">
    <thead class="table-light">
        <tr>
            <th>Tên Khách hàng</th>
            <th>Số điện thoại</th>
            <th>Ngày đặt</th>
            <th>Trạng thái</th>
            <th>Tổng tiền</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var order in Model)
        {
            <tr>
                <td>@Html.ActionLink(order.Name, "Details", "OrderManager", new { id = order.Id }, new { @class = "text-decoration-none fw-bold" })</td>
                <td>@order.Phone</td>
                <td>@order.OrderDate.ToString("dd/MM/yyyy")</td>

                <!-- Badge trạng thái -->
                <td>
                    @if (order.OrderStatus == "Pending")
                    {
                        <span class="badge bg-warning text-dark">Đang chờ xác nhận</span>
                    }
                    else if (order.OrderStatus == "Processing")
                    {
                        <span class="badge bg-info text-dark">Đang xử lý</span>
                    }
                    else if (order.OrderStatus == "Delivered")
                    {
                        <span class="badge bg-success">Đã giao</span>
                    }
                    else if (order.OrderStatus == "Cancelled")
                    {
                        <span class="badge bg-danger">Đã hủy</span>
                    }
                </td>

                <!-- Tổng tiền -->
                <td>@order.TotalAmount.ToString("N0") ₫</td>

                <!-- Hành động -->
                <td>
                    @if (order.OrderStatus == "Pending")
                    {
                        <form action="@Url.Action("MarkAsProcessing", "OrderManager")" method="post" style="display:inline;">
                            <input type="hidden" name="id" value="@order.Id" />
                            <input type="hidden" name="page" value="@ViewBag.Page" />
                            <input type="hidden" name="startDate" value="@ViewBag.StartDate" />
                            <input type="hidden" name="endDate" value="@ViewBag.EndDate" />
                            <button type="submit" class="btn btn-success btn-sm">Xác nhận</button>
                        </form>
                        @Html.ActionLink("Chi tiết", "Details", "OrderManager", new { id = order.Id }, new { @class = "btn btn-outline-info btn-sm me-2" })
                    }
                    else if (order.OrderStatus == "Processing")
                    {
                        <form action="@Url.Action("MarkAsDelivered", "OrderManager")" method="post" style="display:inline;">
                            <input type="hidden" name="id" value="@order.Id" />
                            <input type="hidden" name="page" value="@ViewBag.Page" />
                            <input type="hidden" name="startDate" value="@ViewBag.StartDate" />
                            <input type="hidden" name="endDate" value="@ViewBag.EndDate" />
                            <button type="submit" class="btn btn-primary btn-sm">Đã giao</button>
                        </form>
                        @Html.ActionLink("Chi tiết", "Details", "OrderManager", new { id = order.Id }, new { @class = "btn btn-outline-info btn-sm me-2" })
                    }
                    else if (order.OrderStatus == "Cancelled")
                    {
                        @Html.ActionLink("Chi tiết", "Details", "OrderManager", new { id = order.Id }, new { @class = "btn btn-outline-info btn-sm me-2" })
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- 📄 Phân trang -->
@if (ViewBag.TotalPages > 1)
{
    <nav class="d-flex justify-content-center mt-3">
        <ul class="pagination">
            <!-- Nút Trước -->
            <li class="page-item @(ViewBag.Page <= 1 ? "disabled" : "")">
                <a class="page-link" href="@Url.Action("Index", new { page = ViewBag.Page - 1, startDate = ViewBag.StartDate, endDate = ViewBag.EndDate })">Trước</a>
            </li>

            <!-- Các số trang -->
            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <li class="page-item @(i == ViewBag.Page ? "active" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { page = i, startDate = ViewBag.StartDate, endDate = ViewBag.EndDate })">@i</a>
                </li>
            }

            <!-- Nút Sau -->
            <li class="page-item @(ViewBag.Page >= ViewBag.TotalPages ? "disabled" : "")">
                <a class="page-link" href="@Url.Action("Index", new { page = ViewBag.Page + 1, startDate = ViewBag.StartDate, endDate = ViewBag.EndDate })">Sau</a>
            </li>
        </ul>
    </nav>
}

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function () {
            $("#btnManagerProduct").click(function () {
                window.location.href = '@Url.Action("Index", "ProductManager")';
            });

            $("#btnDiscount").click(function () {
                window.location.href = '@Url.Action("Index", "DiscountManager")';
            });

            $("#btnOrder").click(function () {
                window.location.href = '@Url.Action("Index", "OrderManager")';
            });

            $("#btnFeedback").click(function () {
                window.location.href = '@Url.Action("Index", "FeedbackManager")';
            });
        });
    </script>
}
