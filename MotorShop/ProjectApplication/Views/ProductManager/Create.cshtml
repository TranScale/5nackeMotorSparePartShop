@model ProjectApplication.Models.ProductViewDetail


<h2 class="mb-3">Thêm sản phẩm mới</h2>

@using (Html.BeginForm("Create", "ProductManager", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()

<div class="card shadow-sm p-4">
    <h4 class="mb-3">Thông tin sản phẩm</h4>
    <hr />
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

    <!-- Upload ảnh -->
    <div class="form-group mb-3">
        <label class="control-label fw-bold">Ảnh sản phẩm</label>
        <input type="file" name="ImageFile" class="form-control" accept="image/*" />
    </div>

    <!-- Brand -->
    <div class="form-group mb-3">
        @Html.LabelFor(model => model.BrandId, htmlAttributes: new { @class = "control-label fw-bold" })
        <select id="BrandId" name="BrandId" class="form-control">
            <option value="1">Yamaha</option>
            <option value="2">Honda</option>
        </select>
    </div>

    <!-- Product Name -->
    <div class="form-group mb-3">
        @Html.LabelFor(model => model.ProductName, htmlAttributes: new { @class = "control-label fw-bold" })
        @Html.TextBoxFor(model => model.ProductName, new { @class = "form-control", placeholder = "Nhập tên sản phẩm..." })
        @Html.ValidationMessageFor(model => model.ProductName, "", new { @class = "text-danger" })
    </div>

    <!-- Product Type -->
    <div class="form-group mb-3">
        @Html.LabelFor(model => model.ProductType, htmlAttributes: new { @class = "control-label fw-bold" })
        <select id="ProductType" name="ProductType" class="form-control">
            <option value="Vehicle">Xe</option>
            <option value="SparePart">Phụ tùng</option>
        </select>
    </div>

    <!-- Price -->
    <div class="form-group mb-3">
        @Html.LabelFor(model => model.ProductPrice, htmlAttributes: new { @class = "control-label fw-bold" })
        @Html.TextBoxFor(model => model.ProductPrice, new { @class = "form-control", placeholder = "Nhập giá..." })
        @Html.ValidationMessageFor(model => model.ProductPrice, "", new { @class = "text-danger" })
    </div>

    <!-- Quantity -->
    <div class="form-group mb-3">
        @Html.LabelFor(model => model.ProductQuantity, htmlAttributes: new { @class = "control-label fw-bold" })
        @Html.TextBoxFor(model => model.ProductQuantity, new { @class = "form-control", placeholder = "Nhập số lượng..." })
        @Html.ValidationMessageFor(model => model.ProductQuantity, "", new { @class = "text-danger" })
    </div>

    <!-- Description -->
    <div class="form-group mb-3">
        @Html.LabelFor(model => model.ProductDescription, htmlAttributes: new { @class = "control-label fw-bold" })
        @Html.TextAreaFor(model => model.ProductDescription, new { @class = "form-control", rows = 3, placeholder = "Nhập mô tả sản phẩm..." })
        @Html.ValidationMessageFor(model => model.ProductDescription, "", new { @class = "text-danger" })
    </div>

    <!-- Vehicle-specific Fields -->
    <div id="vehicleFields">
        <hr />
        <h5 class="fw-bold">Thông tin xe</h5>

        <!-- Engine -->
        <div class="form-group mb-3">
            @Html.LabelFor(model => model.Engine, htmlAttributes: new { @class = "control-label fw-bold" })
            <select id="Engine" name="Engine" class="form-control">
                <option value="100">100cc</option>
                <option value="110">110cc</option>
                <option value="125">125cc</option>
                <option value="150">150cc</option>
                <option value="300">300cc</option>
            </select>
        </div>

        <!-- Vehicle Type -->
        <div class="form-group mb-3">
            @Html.LabelFor(model => model.VehicleType, htmlAttributes: new { @class = "control-label fw-bold" })
            <select id="VehicleType" name="VehicleType" class="form-control">
                <option value="Manual">Xe số</option>
                <option value="Clutch">Xe côn tay</option>
                <option value="Scooter">Xe tay ga</option>
            </select>
        </div>

        <!-- Fuel Capacity -->
        <div class="form-group mb-3">
            @Html.LabelFor(model => model.FuelCapacity, htmlAttributes: new { @class = "control-label fw-bold" })
            <select id="FuelCapacity" name="FuelCapacity" class="form-control">
                <option value="4.5">4.5l</option>
                <option value="5">5l</option>
                <option value="5.5">5.5l</option>
                <option value="6">6l</option>
            </select>
        </div>

        <!-- Color -->
        <div class="form-group mb-3">
            @Html.LabelFor(model => model.Color, htmlAttributes: new { @class = "control-label fw-bold" })
            @Html.EnumDropDownListFor(model => model.Color, new { @class = "form-control" })
            @Html.ValidationMessageFor(model => model.Color, "", new { @class = "text-danger" })
        </div>
    </div>

    <!-- Submit -->
    <div class="form-group mt-4">
        <input type="submit" value="Thêm sản phẩm" class="btn btn-success" />
        @Html.ActionLink("⬅️ Quay lại", "Index", null, new { @class = "btn btn-secondary ms-2" })
    </div>
</div>
}

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        // Ẩn/hiện các field của Vehicle
        function toggleVehicleFields() {
            var type = $("#ProductType").val();
            if (type === "Vehicle") {
                $("#vehicleFields").show();
            } else {
                $("#vehicleFields").hide();
            }
        }

        $(document).ready(function () {
            toggleVehicleFields();
            $("#ProductType").change(toggleVehicleFields);
        });
    </script>
}
