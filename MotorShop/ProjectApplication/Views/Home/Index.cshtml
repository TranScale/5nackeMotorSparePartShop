@model List<ProjectApplication.Models.ProductViewIndex>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Cửa Hàng";
}


<!-- 🔹 Banner khuyến mãi -->
@Html.Action("PromotionBanners", "DiscountManager")




<div class="container mt-5">
    <h2 class="fw-bold mb-4 text-center">CỬA HÀNG</h2>

    <div class="row">
        <!-- Sidebar bộ lọc bên trái -->
        <div class="col-md-3">
            <div class="card shadow-sm sticky-top" style="top: 80px;">
                <div class="card-body">
                    <h5 class="fw-bold mb-3 text-center">Bộ lọc</h5>
                    @using (Html.BeginForm("Index", "Home", FormMethod.Get))
                    {
                        <!-- Loại sản phẩm -->
                        <div class="mb-3">
                            <label for="productType" class="form-label fw-semibold">Loại sản phẩm</label>
                            @Html.DropDownList("productType", ViewBag.ProductType as SelectList, "Tất cả",
                                new { @class = "form-select", onchange = "this.form.submit();" })
                        </div>

                        <!-- Khoảng giá -->
                        <div class="mb-3">
                            <label for="priceRange" class="form-label fw-semibold">Khoảng giá</label>
                            @Html.DropDownList("priceRange", new List<SelectListItem>
                            {
                                new SelectListItem { Text = "Tất cả", Value = "", Selected = (ViewBag.PriceRange == null || ViewBag.PriceRange == "") },
                                new SelectListItem { Text = "Dưới 30 Triệu", Value = "30M", Selected = (ViewBag.PriceRange == "30M") },
                                new SelectListItem { Text = "30 - 40 Triệu", Value = "40M", Selected = (ViewBag.PriceRange == "40M") },
                                new SelectListItem { Text = "Trên 40 Triệu", Value = "40M_UP", Selected = (ViewBag.PriceRange == "40M_UP") }
                            }, new { @class = "form-select", onchange = "this.form.submit();" })
                        </div>

                        <!-- Sắp xếp -->
                        <div class="mb-3">
                            <label for="sortBy" class="form-label fw-semibold">Sắp xếp giá</label>
                            @Html.DropDownList("sortBy", new List<SelectListItem>
                            {
                                new SelectListItem { Text = "Mặc định", Value = "" },
                                new SelectListItem { Text = "Thấp → Cao", Value = "price_asc", Selected = (ViewBag.CurrentSort == "price_asc") },
                                new SelectListItem { Text = "Cao → Thấp", Value = "price_desc", Selected = (ViewBag.CurrentSort == "price_desc") }
                            }, new { @class = "form-select", onchange = "this.form.submit();" })
                        </div>

                        <!-- Tìm kiếm -->
                        <div class="mb-3">
                            <label for="searchString" class="form-label fw-semibold">Tìm kiếm</label>
                            <div class="input-group">
                                @Html.TextBox("searchString", null, new { @class = "form-control", placeholder = "Nhập tên..." })
                                <button type="submit" class="btn btn-primary">Tìm</button>
                            </div>
                        </div>

                        <!-- Xem giỏ hàng -->
                        @*<div class="d-grid mt-4">
                                @Html.ActionLink("Xem Giỏ Hàng", "Cart", "Home", null, new { @class = "btn btn-warning fw-semibold" })
                            </div>*@
                    }
                </div>
            </div>
        </div>

        <!-- Khu vực hiển thị sản phẩm bên phải -->
        <div class="col-md-9">
            @if (Model != null && Model.Any())
            {
                <div class="row gx-4 gx-lg-5 row-cols-2 row-cols-md-3 row-cols-xl-4 justify-content-center">
                    @foreach (var item in Model)
                    {
                        var path = string.IsNullOrEmpty(item.ImagePath)
                            ? Url.Content("~/Content/Images/default.png")
                            : Url.Content("~/" + item.ImagePath.TrimStart('/', '~'));

                        <div class="col mb-5">
                            <div class="card h-100 shadow-sm product-card position-relative hover-shadow">

                                <!-- Badge Sale (show discount value if exists) -->
                                @if (item.HasDiscount)
                                {
                                    <div class="badge bg-danger text-white position-absolute" style="top: 0.5rem; right: 0.5rem">Sale</div>
                                }


                                <!-- Ảnh (click to details) -->
                                <a href="@Url.Action("Details", "Home", new { id = item.ProductId })" title="Xem chi tiết @item.ProductName">
                                    <img class="card-img-top" src="@path" alt="@item.ProductName" style="object-fit: cover; height: 200px;" />
                                </a>

                                <!-- Thông tin sản phẩm -->
                                <div class="card-body p-4">
                                    <div class="text-center">
                                        <h5 class="fw-bolder mb-2">
                                            <a href="@Url.Action("Details", "Home", new { id = item.ProductId })" class="text-decoration-none fw-bold">
                                                @item.ProductName
                                            </a>
                                        </h5>

                                        @if (item.HasDiscount && item.OriginalPrice.HasValue)
                                        {
                                            <div>
                                                <span class="text-muted text-decoration-line-through">
                                                    @string.Format("{0:N0}", item.OriginalPrice.Value) ₫
                                                </span>
                                            </div>
                                            <div class="text-danger fw-bold my-1">
                                                @string.Format("{0:N0}", item.ProductPrice) ₫
                                            </div>
                                            <small class="text-success fw-semibold d-block">
                                                Tiết kiệm @((item.OriginalPrice.Value - item.ProductPrice).ToString("N0")) ₫
                                            </small>
                                        }
                                        else
                                        {
                                            <div class="fw-semibold">@string.Format("{0:N0}", item.ProductPrice) ₫</div>
                                        }

                                        <small class="text-muted d-block mt-2">Còn lại: @item.ProductQuantity</small>
                                    </div>
                                </div>

                                <!-- Hành động: Thêm vào giỏ (form POST riêng, KHÔNG nằm trong <a>) -->
                                <div class="card-footer p-4 pt-0 border-top-0 bg-transparent">
                                    <div class="text-center">
                                        @using (Html.BeginForm("AddToCart", "Home", FormMethod.Post))
                                        {
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="productId" value="@item.ProductId" />
                                            <input type="hidden" name="quantity" value="1" />
                                            <button type="submit" class="btn btn-outline-success mt-auto">Thêm vào giỏ</button>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="alert alert-info text-center">Không tìm thấy sản phẩm nào.</div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            var successMessage = '@TempData["SuccessMessage"]';
            if (successMessage && successMessage.length > 0) {
                successMessage = successMessage.replace(/&quot;/g, '"').replace(/&#39;/g, "'");
                var toastHtml = `
                    <div class="toast bg-success text-white text-center position-fixed bottom-0 end-0 m-3"
                         role="alert" aria-live="assertive" aria-atomic="true" data-delay="1500">
                        <div class="toast-body">
                            <strong>Thành công!</strong> ${successMessage}
                        </div>
                    </div>`;
                $('body').append(toastHtml);
                $('.toast').toast({ delay: 1500 }).toast('show');
            }
        });
    </script>
}
