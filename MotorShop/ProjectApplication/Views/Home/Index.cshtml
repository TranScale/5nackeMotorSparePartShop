@model List<ProjectApplication.Models.ProductViewIndex>
@{
    ViewBag.Title = "Cửa Hàng";
}

<div class="container mt-4">
    <h2>Danh sách sản phẩm</h2>
    <hr />

    <div class="d-flex justify-content-between align-items-start mb-3">

        @using (Html.BeginForm("Index", "Home", FormMethod.Get, new { @class = "flex-grow-1 mr-3" }))
        {
            <div class="d-flex flex-column">

                @* --- LỌC THEO LOẠI SP VÀ KHOẢNG GIÁ --- *@
                <div class="d-flex mb-3">

                    @* LỌC THEO LOẠI SẢN PHẨM *@
                    <div class="form-group" style="margin-right: 50px;">
                        <label for="productType" class="mr-sm-2">Chọn loại sản phẩm:</label>
                        @Html.DropDownList("productType", ViewBag.ProductType as SelectList, new { @class = "form-control" })
                    </div>

                    @* LỌC THEO KHOẢNG GIÁ *@
                    <div class="form-group">
                        <label for="priceRange" class="mr-sm-2">Khoảng giá:</label>
                        @Html.DropDownList("priceRange", new List<SelectListItem>
                        {
                            new SelectListItem { Text = "Tất cả", Value = "", Selected = (ViewBag.PriceRange == null || ViewBag.PriceRange == "") },
                            new SelectListItem { Text = "Dưới 30 Triệu", Value = "30M", Selected = (ViewBag.PriceRange == "30M") },
                            new SelectListItem { Text = "30 Triệu - 40 Triệu", Value = "40M", Selected = (ViewBag.PriceRange == "40M") },
                            new SelectListItem { Text = "Trên 40 Triệu", Value = "40M_UP", Selected = (ViewBag.PriceRange == "40M_UP") }
                        }, new { @class = "form-control", onchange = "this.form.submit();" })
                    </div>
                </div>

                @* --- TÌM KIẾM THEO TÊN + NÚT TÌM KIẾM --- *@
                <div class="d-flex mb-3 align-items-end">

                    @* TRƯỜNG TÌM KIẾM KÝ TỰ *@
                    <div class="form-group mr-3">
                        <label for="searchString" class="mr-sm-2">Tìm kiếm theo tên:</label>
                        @Html.TextBox("searchString", null, new { @class = "form-control", placeholder = "Nhập tên..." })
                    </div>

                    <button type="submit" class="btn btn-primary">Tìm kiếm</button>
                </div>

                @* --- SẮP XẾP GIÁ --- *@
                <div class="d-flex mb-3">
                    <div class="form-group">
                        <label for="sortBy" class="mr-sm-2">Sắp xếp giá:</label>
                        @Html.DropDownList("sortBy", new List<SelectListItem>
                        {
                            new SelectListItem { Text = "Mặc định", Value = "" },
                            new SelectListItem { Text = "Giá: Thấp -> Cao", Value = "price_asc", Selected = (ViewBag.CurrentSort == "price_asc") },
                            new SelectListItem { Text = "Giá: Cao -> Thấp", Value = "price_desc", Selected = (ViewBag.CurrentSort == "price_desc") }
                        }, new { @class = "form-control", onchange = "this.form.submit();" })
                    </div>
                </div>
            </div>
        }

        @Html.ActionLink("Xem Giỏ Hàng", "Cart", "Home", null, new { @class = "btn btn-lg btn-warning" })
    </div>

    <table class="table table-striped table-hover mt-3">
        <thead class="thead-dark">
            <tr>
                <th>image</th>
                <th>Tên</th>
                <th>Giá</th>
                <th>Còn lại</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @* --- KHỐI ĐƯỜNG DẪN ẢNH --- *@
                            @{
                                string path = item.ImagePath;

                                // 1. Nếu đường dẫn rỗng, dùng ảnh mặc định
                                if (string.IsNullOrEmpty(path))
                                {
                                    path = "Content/Images/default.png";
                                }

                                path = path.TrimStart('/', '~');
                                path = "~/" + path;

                                var imagePath = Url.Content(path);
                            }
                            <img src="@imagePath" alt="Product Image" width="150" />
                            @* ---------------------------------------------------------------- *@
                        </td>
                        <td>
                            @Html.ActionLink(item.ProductName, "Details", "Home", new { id = item.ProductId }, null)
                        </td>
                        <td>
                            @if (item.HasDiscount)
                            {
                                <span style="text-decoration:line-through; color:gray;">
                                    @string.Format("{0:N0}", item.OriginalPrice) VNĐ
                                </span><br />
                                <span style="color:red; font-weight:bold;">
                                    @string.Format("{0:N0}", item.ProductPrice) VNĐ
                                </span>
                            }
                            else
                            {
                                <span>@string.Format("{0:N0}", item.ProductPrice) VNĐ</span>
                            }
                        </td>
                        <td>@item.ProductQuantity</td>
                        <td>
                            @using (Html.BeginForm("AddToCart", "Home", FormMethod.Post))
                            {
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="productId" value="@item.ProductId" />
                                <input type="hidden" name="quantity" value="1" />
                                <button type="submit" class="btn btn-sm btn-success">Thêm vào giỏ</button>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4" class="text-center">Không tìm thấy sản phẩm nào.</td>
                </tr>
            }
        </tbody>
    </table>
</div>


@section Scripts {
    <script>
        $(document).ready(function () {
            var successMessage = '@TempData["SuccessMessage"]';
            if (successMessage && successMessage.length > 0) {
                successMessage = successMessage.replace(/&quot;/g, '"').replace(/&#39;/g, "'");
                var toastHtml = `
                    <div class="toast bg-success text-white text-center"role="alert" aria-live="assertive" aria-atomic="true" data-delay="1500">
                        <div class="toast-body">
                            <strong>Thành công!</strong> ${successMessage}
                        </div>
                    </div>`;
                $('#toast-container').append(toastHtml);
                var newToast = $('#toast-container').find('.toast:last');
                newToast.toast({ delay: 1500 }).toast('show');
            }
        });
    </script>
}