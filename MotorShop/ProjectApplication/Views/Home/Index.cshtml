@model List<ProjectApplication.Models.ProductViewIndex>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Cửa Hàng";
}

<!-- 🔹 Banner khuyến mãi -->
@Html.Action("PromotionBanners", "DiscountManager")

<div class="container mt-5">
    <h2 class="fw-bold mb-4 text-center">CỬA HÀNG</h2>

    <div class="row">
        <!-- Sidebar bộ lọc -->
        <div class="col-md-3">
            <div class="card shadow-sm sticky-top" style="top: 80px;">
                <div class="card-body">
                    <h5 class="fw-bold mb-3 text-center">Bộ lọc</h5>
                    @using (Html.BeginForm("Index", "Home", FormMethod.Get, new { id = "filterForm" }))
                    {
                        <!-- Loại sản phẩm -->
                        <div class="mb-3">
                            <label for="productType" class="form-label fw-semibold">Loại sản phẩm</label>
                            @Html.DropDownList("productType", ViewBag.ProductType as SelectList, "Tất cả",
                                new { @class = "form-select", onchange = "this.form.submit();" })
                        </div>

                        <!-- Khoảng giá -->
                        <div class="mb-3">
                            <label for="priceRange" class="form-label fw-semibold">Khoảng giá</label>
                            @Html.DropDownList("priceRange", new List<SelectListItem>
                            {
                                new SelectListItem { Text = "Tất cả", Value = "", Selected = (ViewBag.PriceRange == null || ViewBag.PriceRange == "") },
                                new SelectListItem { Text = "Dưới 30 Triệu", Value = "30M", Selected = (ViewBag.PriceRange == "30M") },
                                new SelectListItem { Text = "30 - 40 Triệu", Value = "40M", Selected = (ViewBag.PriceRange == "40M") },
                                new SelectListItem { Text = "Trên 40 Triệu", Value = "40M_UP", Selected = (ViewBag.PriceRange == "40M_UP") }
                            }, new { @class = "form-select", onchange = "this.form.submit();" })
                        </div>

                        <!-- Sắp xếp -->
                        <div class="mb-3">
                            <label for="sortBy" class="form-label fw-semibold">Sắp xếp giá</label>
                            @Html.DropDownList("sortBy", new List<SelectListItem>
                            {
                                new SelectListItem { Text = "Mặc định", Value = "" },
                                new SelectListItem { Text = "Thấp → Cao", Value = "price_asc", Selected = (ViewBag.CurrentSort == "price_asc") },
                                new SelectListItem { Text = "Cao → Thấp", Value = "price_desc", Selected = (ViewBag.CurrentSort == "price_desc") }
                            }, new { @class = "form-select", onchange = "this.form.submit();" })
                        </div>

                        <!-- Tìm kiếm -->
                        <div class="mb-3">
                            <label for="searchString" class="form-label fw-semibold">Tìm kiếm</label>
                            <div class="input-group">
                                @Html.TextBox("searchString", ViewBag.SearchString as string, new { @class = "form-control", placeholder = "Nhập tên..." })
                                <button type="submit" class="btn btn-primary">Tìm</button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Danh sách sản phẩm -->
        <div id="productContainer" class="col-md-9">
            @Html.Partial("_ProductList", Model)
        </div>
    </div>

    <!-- Phân trang -->
    <nav aria-label="Page navigation">
        <ul class="pagination justify-content-center mt-4">
            @if (ViewBag.CurrentPage > 1)
            {
                <li class="page-item">
                    <a class="page-link" href="@Url.Action("Index", new {
                        page = ViewBag.CurrentPage - 1,
                        searchString = ViewBag.SearchString,
                        sortBy = ViewBag.CurrentSort,
                        productType = ViewBag.SelectedType,
                        priceRange = ViewBag.SelectedPrice
                    })">«</a>
                </li>
            }

            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                    <a class="page-link" href="@Url.Action("Index", new {
                        page = i,
                        searchString = ViewBag.SearchString,
                        sortBy = ViewBag.CurrentSort,
                        productType = ViewBag.SelectedType,
                        priceRange = ViewBag.SelectedPrice
                    })">@i</a>
                </li>
            }

            @if (ViewBag.CurrentPage < ViewBag.TotalPages)
            {
                <li class="page-item">
                    <a class="page-link" href="@Url.Action("Index", new {
                        page = ViewBag.CurrentPage + 1,
                        searchString = ViewBag.SearchString,
                        sortBy = ViewBag.CurrentSort,
                        productType = ViewBag.SelectedType,
                        priceRange = ViewBag.SelectedPrice
                    })">»</a>
                </li>
            }
        </ul>
    </nav>
</div>

@section Scripts {
    <script>
        // ✅ AJAX phân trang mượt
        $(document).on("click", ".pagination a", function (e) {
            e.preventDefault();
            var url = $(this).attr("href");

            $.get(url, function (data) {
                // Nếu trả về partial (chỉ có danh sách)
                if (data.trim().startsWith("<div") || data.trim().startsWith("<p") || data.trim().startsWith("<section")) {
                    $("#productContainer").html(data);
                }
                else {
                    // Nếu trả về full page thì trích phần cần thiết
                    $("#productContainer").html($(data).find("#productContainer").html());
                    $(".pagination").html($(data).find(".pagination").html());
                }

                $('html, body').animate({ scrollTop: $("#productContainer").offset().top - 100 }, 300);
            });


        // ✅ Khi submit bộ lọc hoặc tìm kiếm => reset về trang 1
        $("#filterForm").on("submit", function (e) {
            e.preventDefault();
            var url = $(this).attr("action") + "?" + $(this).serialize();
            $.get(url, function (data) {
                $("#productContainer").html($(data).find("#productContainer").html());
                $(".pagination").html($(data).find(".pagination").html());
            });
        });
            // ✅ Khi click vào số trang -> load AJAX
            $(document).on("click", ".pagination a", function (e) {
                e.preventDefault();

                var url = $(this).attr("href");
                if (!url) return;

                $.get(url, function (data) {
                    // Thay cả danh sách + phân trang
                    $("#productContainer").html($(data).find("#productContainer").html());
                    $(".pagination").html($(data).find(".pagination").html());

                    // Cuộn lên đầu danh sách
                    $('html, body').animate({ scrollTop: $("#productContainer").offset().top - 100 }, 300);
                });
            });

            // ✅ Khi submit form lọc -> load AJAX
            $("#filterForm").on("submit", function (e) {
                e.preventDefault();

                var url = $(this).attr("action") + "?" + $(this).serialize();

                $.get(url, function (data) {
                    $("#productContainer").html($(data).find("#productContainer").html());
                    $(".pagination").html($(data).find(".pagination").html());
                });
            });
        </script>


}
