@model ProjectApplication.Models.ProductViewDetail

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Chi tiết sản phẩm: " + Model.ProductName;
}

<div class="container mt-5 mb-5">
    <div class="row g-4">
        <!-- 🖼️ KHỐI 1: Hình ảnh + Thông tin + Nút mua -->
        <div class="col-md-5 text-center">
            @{
                string path = Model.ImagePath;
                if (string.IsNullOrEmpty(path))
                {
                    path = "Content/Images/default.png";
                }
                path = "~/" + path.TrimStart('/', '~');
                var imagePath = Url.Content(path);
            }

            <div class="card shadow-sm p-3">
                <img src="@imagePath"
                     alt="@Model.ProductName"
                     class="img-fluid rounded-3 border product-image"
                     style="max-height: 400px; object-fit: contain; transition: transform .3s;" />
            </div>
        </div>

        <div class="col-md-7">
            <div class="card shadow-sm p-4 h-100">
                <h3 class="fw-bold mb-3 text-dark">@Model.ProductName</h3>

                <div class="mb-3">
                    <span class="badge bg-info text-dark">@Model.ProductType</span>
                    @if (Model.HasDiscount)
                    {
                        <span class="badge bg-danger ms-2">Giảm giá</span>
                    }
                </div>

                <hr />

                <dl class="row mb-0">
                    <dt class="col-sm-4 fw-semibold">Hãng</dt>
                    <dd class="col-sm-8">@Model.BrandName</dd>

                    <dt class="col-sm-4 fw-semibold">Giá</dt>
                    <dd class="col-sm-8">
                        @if (Model.HasDiscount)
                        {
                            <div>
                                <span class="text-muted text-decoration-line-through">
                                    @string.Format("{0:N0} ₫", Model.OriginalPrice)
                                </span>
                            </div>
                            <div class="text-danger fw-bold fs-5">
                                @string.Format("{0:N0} ₫", Model.ProductPrice)
                            </div>
                            <small class="text-success fw-semibold d-block">
                                Tiết kiệm @((Model.OriginalPrice - Model.ProductPrice)?.ToString("N0")) ₫
                            </small>
                        }
                        else
                        {
                            <span class="fw-semibold fs-5">@string.Format("{0:N0} ₫", Model.ProductPrice)</span>
                        }
                    </dd>

                    <dt class="col-sm-4 fw-semibold">Số lượng còn</dt>
                    <dd class="col-sm-8">@Model.ProductQuantity</dd>
                </dl>

                <hr class="my-4" />

                <!-- Nút hành động -->
                <div class="d-flex flex-wrap gap-3">
                    @using (Html.BeginForm("AddToCart", "Home", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="productId" value="@Model.ProductId" />
                        <input type="hidden" name="quantity" value="1" />
                        <input type="hidden" name="buyNow" value="false" />
                        <button type="submit" class="btn btn-success btn-lg flex-grow-1">
                            <i class="fas fa-cart-plus"></i> Thêm vào giỏ
                        </button>
                    }

                    @using (Html.BeginForm("AddToCart", "Home", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="productId" value="@Model.ProductId" />
                        <input type="hidden" name="quantity" value="1" />
                        <input type="hidden" name="buyNow" value="true" />
                        <button type="submit" class="btn btn-primary btn-lg flex-grow-1">
                            <i class="fas fa-credit-card"></i> Mua ngay
                        </button>
                    }

                    <button type="button" class="btn btn-outline-secondary btn-lg flex-grow-1" data-bs-toggle="modal" data-bs-target="#compareModal">
                        <i class="fas fa-balance-scale"></i> So sánh
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- 🧾 KHỐI 2: Mô tả & Thông số kỹ thuật -->
    <div class="card shadow-sm p-4 mt-5">
        <h4 class="fw-bold text-dark mb-3">Mô tả chi tiết</h4>
        <p class="text-muted">@Model.ProductDescription</p>

        @if (Model.ProductType == "Vehicle")
        {
            <hr class="my-3" />
            <h5 class="fw-bold text-primary mb-2">Thông tin xe</h5>

            <table class="table table-bordered align-middle mb-0">
                <tbody>
                    <tr><th class="w-25">Loại xe</th><td>@Model.VehicleType</td></tr>
                    <tr><th>Động cơ</th><td>@($"{Model.Engine} cc")</td></tr>
                    <tr><th>Dung tích xăng</th><td>@($"{Model.FuelCapacity} lít")</td></tr>
                    <tr><th>Màu xe</th><td>@Model.Color</td></tr>
                </tbody>
            </table>
        }
    </div>

    <!-- 💬 KHỐI 3: Đánh giá & Bình luận -->
    <div class="card shadow-sm p-4 mt-5">
        <h4 class="text-primary fw-bold mb-3">Đánh giá sản phẩm</h4>

        @using (Html.BeginForm("AddFeedback", "Home", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <input type="hidden" name="productId" value="@Model.ProductId" />
            <div class="mb-3">
                <label class="form-label fw-semibold">Số sao:</label>
                <select name="rating" class="form-select w-auto d-inline-block">
                    <option value="5">⭐️⭐️⭐️⭐️⭐️ - Tuyệt vời</option>
                    <option value="4">⭐️⭐️⭐️⭐️ - Tốt</option>
                    <option value="3">⭐️⭐️⭐️ - Bình thường</option>
                    <option value="2">⭐️⭐️ - Kém</option>
                    <option value="1">⭐️ - Tệ</option>
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label fw-semibold">Nội dung đánh giá:</label>
                <textarea name="comment" class="form-control" rows="3" placeholder="Nhập cảm nhận của bạn..."></textarea>
            </div>
            <button type="submit" class="btn btn-outline-primary">
                <i class="fas fa-paper-plane"></i> Gửi đánh giá
            </button>
        }

        @if (Model.Feedbacks != null && Model.Feedbacks.Any(f => f.IsApproved))
        {
            <div class="mt-4">
                @foreach (var fb in Model.Feedbacks.Where(f => f.IsApproved).OrderByDescending(f => f.CreatedDate))
                {
                    <div class="border rounded p-3 mb-3 bg-light">
                        <div class="d-flex justify-content-between">
                            <strong>@fb.CustomerName</strong>
                            <small class="text-muted">@fb.CreatedDate.ToString("dd/MM/yyyy HH:mm")</small>
                        </div>
                        <div class="text-warning">
                            @Html.Raw(new string('★', fb.Rating))
                            @Html.Raw(new string('☆', 5 - fb.Rating))
                        </div>
                        <p class="mb-0">@fb.Comment</p>
                    </div>
                }
            </div>
        }
        else
        {
            <p class="text-muted fst-italic mt-3">Chưa có đánh giá nào cho sản phẩm này.</p>
        }

        <div class="mt-4">
            <a href="javascript:history.back()" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Quay lại
            </a>
        </div>
    </div>
</div>

<!-- Modal chọn sản phẩm để so sánh -->
<div class="modal fade" id="compareModal" tabindex="-1" aria-labelledby="compareModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="compareModalLabel">Chọn sản phẩm để so sánh</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="input-group mb-3">
                    <input type="text" id="compareSearch" class="form-control" placeholder="Tìm sản phẩm..." />
                    <button class="btn btn-outline-primary" id="btnSearchCompare"><i class="fas fa-search"></i></button>
                </div>
                <div id="compareProductList" class="row g-3">
                    <div class="text-center text-muted">Đang tải danh sách...</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Kết quả so sánh -->
<div id="compareResult" class="mt-5"></div>
<div class="text-center mt-3" id="compareBackWrapper" style="display:none;">
    <button id="btnExitCompare" class="btn btn-outline-secondary">
        <i class="fas fa-arrow-left"></i> Thoát chế độ so sánh
    </button>
</div>

<!-- Toast -->
<div id="toast-container" class="position-fixed top-0 end-0 p-3" style="z-index:1055;"></div>

@section Scripts {
    <script>
        $(document).ready(function () {

            // 🟢 Hiển thị toast khi có thông báo
            var successMessage = '@TempData["SuccessMessage"]';
            if (successMessage && successMessage.length > 0) {
                showToast(successMessage, "success");
            }

            // 🖼️ Zoom ảnh sản phẩm
            const img = document.querySelector('.product-image');
            if (img) {
                img.addEventListener('mouseenter', () => img.style.transform = 'scale(1.05)');
                img.addEventListener('mouseleave', () => img.style.transform = 'scale(1)');
            }

            // 🧩 Mở modal chọn sản phẩm so sánh
            $('#compareModal').on('shown.bs.modal', function () {
                loadCompareList();
            });

            // 🔍 Nút tìm kiếm trong modal
            $('#btnSearchCompare').click(function () {
                loadCompareList($('#compareSearch').val());
            });

            // ⚙️ Hàm load danh sách sản phẩm trong modal
            function loadCompareList(search = "") {
                $.get('@Url.Action("GetProductListForCompare", "Home")', { search: search }, function (data) {
                    $('#compareProductList').html(data);
                });
            }

            // 🟡 Xử lý chọn sản phẩm để so sánh
            $(document).on('click', '.btn-compare-select', function () {
                var productId = $(this).data('id');
                var currentId = '@Model.ProductId';

                $.get('@Url.Action("CompareProduct", "Home")', { currentId: currentId, compareId: productId }, function (response) {
                    if (response.error) {
                        showToast(response.message, "danger");
                        return;
                    }

                    $('#compareResult').html(response);
                    $('#compareBackWrapper').show();

                    // Đóng modal đúng cách
                    $('#compareModal').modal('hide');

                    // Cuộn xuống vùng hiển thị kết quả
                    $('html, body').animate({ scrollTop: $('#compareResult').offset().top }, 500);
                });
            });

            // ✅ Khi modal ẩn hoàn toàn → mở lại scroll, xóa backdrop
            $('#compareModal').on('hidden.bs.modal', function () {
                $('body').removeClass('modal-open').css({
                    'overflow': 'auto',
                    'padding-right': ''
                });
                $('.modal-backdrop').remove();
            });

            // 🔴 Thoát chế độ so sánh
            $(document).on('click', '#btnExitCompare', function () {
                $('#compareResult').empty();
                $('#compareBackWrapper').hide();

                // Reset scroll + cleanup đảm bảo
                $('body').removeClass('modal-open').css({
                    'overflow': 'auto',
                    'padding-right': ''
                });
                $('.modal-backdrop').remove();

                $('html, body').animate({ scrollTop: 0 }, 400);
            });

            // 🔔 Hàm hiển thị toast thông báo
            function showToast(message, type = "success") {
                var toastHtml = `
                    <div class="toast bg-${type} text-white text-center" role="alert" data-bs-delay="2500">
                        <div class="toast-body">${message}</div>
                    </div>`;
                $('#toast-container').append(toastHtml);
                var toastEl = $('#toast-container .toast:last');
                var bsToast = new bootstrap.Toast(toastEl[0]);
                bsToast.show();
            }
        });
    </script>
}

