@model ProjectApplication.Models.ProductViewDetail

@{
    ViewBag.Title = "Chi tiết sản phẩm: " + Model.ProductName;
}

<div class="container mt-4">
    <h2>Chi tiết sản phẩm</h2>
    <hr />

    <div class="row">
        <div class="col-md-7">
            <h4>@Model.ProductName</h4>
            <p><b>Mã sản phẩm:</b> @Model.ProductId</p>
            <p><b>Loại:</b> @Model.ProductType</p>
            <p><b>Hãng:</b> @Model.BrandName</p>

            <!-- ✅ Chỉ còn giá gốc, không còn khuyến mãi -->
            <p><b>Giá:</b> @string.Format("{0:N0} VNĐ", Model.ProductPrice)</p>

            <p><b>Còn lại:</b> @Model.ProductQuantity</p>

            @if (Model.ProductType == "Vehicle")
            {
                <p><b>Động cơ:</b> @Model.Engine cc</p>
                <p><b>Loại xe:</b> @Model.VehicleType</p>
                <p><b>Dung tích xăng:</b> @Model.FuelCapacity lít</p>
                <p><b>Màu sắc:</b> @Model.Color</p>
                <p><b>Mô tả:</b> @Model.ProductDescription</p>
            }
            else if (Model.ProductType == "SparePart")
            {
                <p><b>Mô tả:</b> @Model.ProductDescription</p>
            }

            <hr />

            <!-- ✅ Nút thao tác -->
            <div class="product-actions mt-4 d-flex gap-3">
                @using (Html.BeginForm("AddToCart", "Home", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="productId" value="@Model.ProductId" />
                    <input type="hidden" name="quantity" value="1" />
                    <input type="hidden" name="buyNow" value="false" />
                    <button type="submit" class="btn btn-success">
                        <i class="fas fa-cart-plus"></i> Thêm vào giỏ
                    </button>
                }

                @using (Html.BeginForm("AddToCart", "Home", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="productId" value="@Model.ProductId" />
                    <input type="hidden" name="quantity" value="1" />
                    <input type="hidden" name="buyNow" value="true" />
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-credit-card"></i> Mua ngay
                    </button>
                }

                <button onclick="window.history.back()" class="btn btn-secondary">
                    Quay lại
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Toast hiển thị thông báo -->
<div id="toast-container" class="position-fixed top-0 end-0 p-3" style="z-index:1055;"></div>

@section Scripts {
    <script>
        $(document).ready(function () {
            var successMessage = '@TempData["SuccessMessage"]';
            if (successMessage && successMessage.length > 0) {
                successMessage = successMessage.replace(/&quot;/g, '"').replace(/&#39;/g, "'");
                var toastHtml = `
                    <div class="toast bg-success text-white text-center" role="alert" data-delay="1500">
                        <div class="toast-body">
                            <strong>Thành công!</strong> ${successMessage}
                        </div>
                    </div>`;
                $('#toast-container').append(toastHtml);
                $('#toast-container .toast:last').toast('show');
            }
        });
    </script>
}
