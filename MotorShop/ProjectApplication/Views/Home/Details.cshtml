@model ProjectApplication.Models.ProductViewDetail

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Chi tiết sản phẩm: " + Model.ProductName;
}

<div class="container mt-5 mb-5">
    <div class="row g-4">
        <!-- 🖼️ KHỐI 1: Hình ảnh + Thông tin + Nút mua -->
        <div class="col-md-5 text-center">
            @{
                string path = Model.ImagePath;
                if (string.IsNullOrEmpty(path))
                {
                    path = "Content/Images/default.png";
                }
                path = "~/" + path.TrimStart('/', '~');
                var imagePath = Url.Content(path);
            }

            <div class="card shadow-sm p-3">
                <img src="@imagePath"
                     alt="@Model.ProductName"
                     class="img-fluid rounded-3 border product-image"
                     style="max-height: 400px; object-fit: contain; transition: transform .3s;" />
            </div>
        </div>

        <div class="col-md-7">
            <div class="card shadow-sm p-4 h-100">
                <h3 class="fw-bold mb-3 text-dark">@Model.ProductName</h3>

                <div class="mb-3">
                    <span class="badge bg-info text-dark">@Model.ProductType</span>
                    @if (Model.HasDiscount)
                    {
                        <span class="badge bg-danger ms-2">Giảm giá</span>
                    }
                </div>

                <hr />

                <dl class="row mb-0">
                    @*<dt class="col-sm-4 fw-semibold">Mã sản phẩm</dt>
                    <dd class="col-sm-8">@Model.ProductId</dd>*@

                    <dt class="col-sm-4 fw-semibold">Hãng</dt>
                    <dd class="col-sm-8">@Model.BrandName</dd>

                    <dt class="col-sm-4 fw-semibold">Giá</dt>
                    <dd class="col-sm-8">
                        @if (Model.HasDiscount)
                        {
                            <div>
                                <span class="text-muted text-decoration-line-through">
                                    @string.Format("{0:N0} ₫", Model.OriginalPrice)
                                </span>
                            </div>
                            <div class="text-danger fw-bold fs-5">
                                @string.Format("{0:N0} ₫", Model.ProductPrice)
                            </div>
                            <small class="text-success fw-semibold d-block">
                                Tiết kiệm @((Model.OriginalPrice - Model.ProductPrice)?.ToString("N0")) ₫
                            </small>
                        }
                        else
                        {
                            <span class="fw-semibold fs-5">@string.Format("{0:N0} ₫", Model.ProductPrice)</span>
                        }
                    </dd>
                    <dt class="col-sm-4 fw-semibold">Số lượng còn</dt>
                    <dd class="col-sm-8">@Model.ProductQuantity</dd>
                </dl>

                <hr class="my-4" />

                <!-- Nút hành động -->
                <div class="d-flex flex-wrap gap-3">
                    @using (Html.BeginForm("AddToCart", "Home", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="productId" value="@Model.ProductId" />
                        <input type="hidden" name="quantity" value="1" />
                        <input type="hidden" name="buyNow" value="false" />
                        <button type="submit" class="btn btn-success btn-lg flex-grow-1">
                            <i class="fas fa-cart-plus"></i> Thêm vào giỏ
                        </button>
                    }

                    @using (Html.BeginForm("AddToCart", "Home", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="productId" value="@Model.ProductId" />
                        <input type="hidden" name="quantity" value="1" />
                        <input type="hidden" name="buyNow" value="true" />
                        <button type="submit" class="btn btn-primary btn-lg flex-grow-1">
                            <i class="fas fa-credit-card"></i> Mua ngay
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- 🧾 KHỐI 2: Mô tả & Thông số kỹ thuật -->
    <div class="card shadow-sm p-4 mt-5">
        <h4 class="fw-bold text-dark mb-3">Mô tả chi tiết</h4>
        <p class="text-muted">@Model.ProductDescription</p>
        @if (Model.ProductType == "Vehicle")
        {
            <hr class="my-3" />
            <h5 class="fw-bold text-primary mb-2">Thông tin xe</h5>

            <table class="table table-bordered align-middle mb-0">
                <tbody>
                    <tr>
                        <th class="w-25">Loại xe</th>
                        <td>@Model.VehicleType</td>
                    </tr>
                    <tr>
                        <th>Động cơ</th>
                        <td>@($"{Model.Engine} cc")</td>
                    </tr>
                    <tr>
                        <th>Dung tích xăng</th>
                        <td>@($"{Model.FuelCapacity} lít")</td>
                    </tr>
                    <tr>
                        <th>Màu xe</th>
                        <td>@Model.Color</td>
                    </tr>
                </tbody>
            </table>

        }
    </div>

    <!-- 💬 KHỐI 3: Đánh giá & Bình luận -->
    <div class="card shadow-sm p-4 mt-5">
        <h4 class="text-primary fw-bold mb-3">Đánh giá sản phẩm</h4>

        @using (Html.BeginForm("AddFeedback", "Home", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <input type="hidden" name="productId" value="@Model.ProductId" />

            <div class="mb-3">
                <label class="form-label fw-semibold">Số sao:</label>
                <select name="rating" class="form-select w-auto d-inline-block">
                    <option value="5">⭐️⭐️⭐️⭐️⭐️ - Tuyệt vời</option>
                    <option value="4">⭐️⭐️⭐️⭐️ - Tốt</option>
                    <option value="3">⭐️⭐️⭐️ - Bình thường</option>
                    <option value="2">⭐️⭐️ - Kém</option>
                    <option value="1">⭐️ - Tệ</option>
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Nội dung đánh giá:</label>
                <textarea name="comment" class="form-control" rows="3" placeholder="Nhập cảm nhận của bạn..."></textarea>
            </div>

            <button type="submit" class="btn btn-outline-primary">
                <i class="fas fa-paper-plane"></i> Gửi đánh giá
            </button>
        }

        @if (Model.Feedbacks != null && Model.Feedbacks.Any(f => f.IsApproved))
        {
            <div class="mt-4">
                @foreach (var fb in Model.Feedbacks.Where(f => f.IsApproved).OrderByDescending(f => f.CreatedDate))
                {
                    <div class="border rounded p-3 mb-3 bg-light">
                        <div class="d-flex justify-content-between">
                            <strong>@fb.CustomerName</strong>
                            <small class="text-muted">@fb.CreatedDate.ToString("dd/MM/yyyy HH:mm")</small>
                        </div>
                        <div class="text-warning">
                            @Html.Raw(new string('★', fb.Rating))
                            @Html.Raw(new string('☆', 5 - fb.Rating))
                        </div>
                        <p class="mb-0">@fb.Comment</p>
                    </div>
                }
            </div>
        }
        else
        {
            <p class="text-muted fst-italic mt-3">Chưa có đánh giá nào cho sản phẩm này.</p>
        }

        <div class="mt-4">
            <a href="javascript:history.back()" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Quay lại
            </a>
        </div>
    </div>
</div>


<!-- Toast thông báo -->
<div id="toast-container" class="position-fixed top-0 end-0 p-3" style="z-index:1055;"></div>

@section Scripts {
    <script>
        $(document).ready(function () {
            var successMessage = '@TempData["SuccessMessage"]';
            if (successMessage && successMessage.length > 0) {
                successMessage = successMessage.replace(/&quot;/g, '"').replace(/&#39;/g, "'");
                var toastHtml = `
                    <div class="toast bg-success text-white text-center" role="alert" data-delay="1500">
                        <div class="toast-body">
                            <strong>Thành công!</strong> ${successMessage}
                        </div>
                    </div>`
                $('#toast-container').append(toastHtml);
                $('#toast-container .toast:last').toast('show');
            }
        });

        // Hiệu ứng zoom ảnh
        const productImage = document.querySelector('.product-image');
        if (productImage) {
            productImage.addEventListener('mouseenter', () => productImage.style.transform = 'scale(1.05)');
            productImage.addEventListener('mouseleave', () => productImage.style.transform = 'scale(1)');
        }
    </script>
}
