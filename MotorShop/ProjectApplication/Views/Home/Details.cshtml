@model ProjectApplication.Models.ProductViewDetail

@{
    ViewBag.Title = "Chi tiết sản phẩm: " + Model.ProductName;
}

<h2 class="mb-3 text-primary fw-bold">Chi tiết sản phẩm</h2>

<div class="card shadow-sm p-4">
    <div class="row">
        <div class="col-md-5 text-center mb-3 mb-md-0">
            @* --- KHỐI CODE XỬ LÝ ĐƯỜNG DẪN ẢNH ĐÃ TỐI ƯU HÓA --- *@
            @{
                string path = Model.ImagePath;

                // 1. Dùng ảnh mặc định nếu path null/empty
                if (string.IsNullOrEmpty(path))
                {
                    path = "Content/Images/default.png";
                }

                // 2. Tinh chỉnh path để loại bỏ các dấu / hoặc ~/ dư thừa
                path = path.TrimStart('/', '~');

                // 3. Thêm ~/ vào đầu để Url.Content() luôn tạo đường dẫn tuyệt đối chính xác
                path = "~/" + path;

                var imagePath = Url.Content(path);
            }

            <img src="@imagePath"
                 alt="@Model.ProductName"
                 class="img-fluid rounded-3 border shadow-sm product-image"
                 style="max-height: 350px; max-width: 100%; object-fit: contain; transition: transform .3s;" />
            @* ---------------------------------------------------------------- *@
        </div>

        <div class="col-md-7">
            <h4 class="fw-bold text-dark mb-3">@Model.ProductName</h4>

            <dl class="row mb-0">
                <dt class="col-sm-4 fw-bold">Mã sản phẩm</dt>
                <dd class="col-sm-8">@Model.ProductId</dd>

                <dt class="col-sm-4 fw-bold">Hãng</dt>
                <dd class="col-sm-8">@Model.BrandName</dd>

                <dt class="col-sm-4 fw-bold">Giá</dt>
                @* === KHỐI HIỂN THỊ GIÁ ĐÃ CHỈNH SỬA === *@
                <dd class="col-sm-8 text-danger fw-semibold">
                    @if (Model.HasDiscount)
                    {
                        // Hiển thị giá gốc bị gạch ngang (nếu có giảm giá)
                        <span style="text-decoration:line-through; color:gray; font-size: 0.9em;">
                            @string.Format("{0:N0} ₫", Model.OriginalPrice)
                        </span>
                        <br />
                        // Hiển thị giá khuyến mãi (đỏ, in đậm)
                        <span class="text-danger fw-bold fs-5">
                            @string.Format("{0:N0} ₫", Model.ProductPrice)
                        </span>
                    }
                    else
                    {
                        // Hiển thị giá thông thường
                        @($"{Model.ProductPrice:N0} ₫")
                    }
                </dd>
                @* ====================================== *@

                <dt class="col-sm-4 fw-bold">Loại</dt>
                <dd class="col-sm-8">
                    <span class="badge bg-info text-dark">@Model.ProductType</span>
                </dd>

                <dt class="col-sm-4 fw-bold">Số lượng còn</dt>
                <dd class="col-sm-8">@Model.ProductQuantity</dd>

                @if (!string.IsNullOrEmpty(Model.ProductDescription))
                {
                    <dt class="col-sm-4 fw-bold">Mô tả</dt>
                    <dd class="col-sm-8">@Model.ProductDescription</dd>
                }

                @* Logic chỉ hiển thị thông tin xe nếu là loại "Vehicle" *@
                @if (Model.ProductType == "Vehicle")
                {
                    <hr class="my-3" />
                    <h5 class="text-primary fw-bold">Thông tin xe</h5>

                    <dt class="col-sm-4 fw-bold">Loại xe</dt>
                    <dd class="col-sm-8">@Model.VehicleType</dd>

                    <dt class="col-sm-4 fw-bold">Động cơ</dt>
                    <dd class="col-sm-8">@($"{Model.Engine} cc")</dd>

                    <dt class="col-sm-4 fw-bold">Dung tích xăng</dt>
                    <dd class="col-sm-8">@($"{Model.FuelCapacity} lít")</dd>

                    <dt class="col-sm-4 fw-bold">Màu xe</dt>
                    <dd class="col-sm-8">@Model.Color</dd>
                }
            </dl>

            <hr class="my-3" />

            <div class="product-actions d-flex gap-2">
                @using (Html.BeginForm("AddToCart", "Home", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="productId" value="@Model.ProductId" />
                    <input type="hidden" name="quantity" value="1" />
                    <input type="hidden" name="buyNow" value="false" />
                    <button type="submit" class="btn btn-success">
                        <i class="fas fa-cart-plus"></i> Thêm vào giỏ
                    </button>
                }

                @using (Html.BeginForm("AddToCart", "Home", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="productId" value="@Model.ProductId" />
                    <input type="hidden" name="quantity" value="1" />
                    <input type="hidden" name="buyNow" value="true" />
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-credit-card"></i> Mua ngay
                    </button>
                }
            </div>
        </div>
    </div>
</div>

<div class="mt-4">
    <button onclick="window.history.back()" class="btn btn-secondary">
        <i class="fas fa-arrow-left"></i> Quay lại
    </button>
</div>

<div id="toast-container" class="position-fixed top-0 end-0 p-3" style="z-index:1055;"></div>

@section Scripts {
    <script>
        // 💰 Logic hiển thị thông báo (Giữ lại từ code gốc của bạn)
        $(document).ready(function () {
            var successMessage = '@TempData["SuccessMessage"]';
            if (successMessage && successMessage.length > 0) {
                successMessage = successMessage.replace(/&quot;/g, '"').replace(/&#39;/g, "'");
                var toastHtml = `
                    <div class="toast bg-success text-white text-center" role="alert" data-delay="1500">
                        <div class="toast-body">
                            <strong>Thành công!</strong> ${successMessage}
                        </div>
                    </div>`;
                $('#toast-container').append(toastHtml);
                $('#toast-container .toast:last').toast('show');
            }
        });

        // 🎨 Hiệu ứng zoom ảnh (Lấy từ code mẫu)
        const productImage = document.querySelector('.product-image');
        if(productImage) {
            productImage.addEventListener('mouseenter', () => productImage.style.transform = 'scale(1.05)');
            productImage.addEventListener('mouseleave', () => productImage.style.transform = 'scale(1)');
        }
    </script>
}