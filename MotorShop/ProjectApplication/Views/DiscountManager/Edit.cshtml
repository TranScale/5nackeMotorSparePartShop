@model ProjectApplication.Models.DiscountViewDetails

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewBag.Title = "Chỉnh sửa giảm giá";
}

<h2>Chỉnh sửa giảm giá</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

<div class="form-horizontal">
    <h4>Thông tin giảm giá</h4>
    <hr />
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.HiddenFor(model => model.Id)

    <!-- Name -->
    <div class="form-group">
        @Html.LabelFor(model => model.Name, htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.EditorFor(model => model.Name, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger" })
        </div>
    </div>

    <!-- Start Date -->
    <div class="form-group">
        @Html.LabelFor(model => model.DateStart, htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.EditorFor(model => model.DateStart, new { htmlAttributes = new { @class = "form-control", type = "date" } })
            @Html.ValidationMessageFor(model => model.DateStart, "", new { @class = "text-danger" })
        </div>
    </div>

    <!-- End Date -->
    <div class="form-group">
        @Html.LabelFor(model => model.DateEnd, htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.EditorFor(model => model.DateEnd, new { htmlAttributes = new { @class = "form-control", type = "date" } })
            @Html.ValidationMessageFor(model => model.DateEnd, "", new { @class = "text-danger" })
        </div>
    </div>

    <!-- Discount Type -->
    <div class="form-group">
        @Html.LabelFor(model => model.DiscountType, htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.DropDownListFor(model => model.DiscountType, new SelectList(new[]
            {
                new { Value = "Coupon", Text = "Mã giảm giá" },
                new { Value = "Promotion", Text = "Chương trình khuyến mãi" }
            }, "Value", "Text", Model.DiscountType), new { @class = "form-control", id = "discountType" })
            @Html.ValidationMessageFor(model => model.DiscountType, "", new { @class = "text-danger" })
        </div>
    </div>

    <!-- Discount Value Type -->
    <div class="form-group">
        @Html.LabelFor(model => model.DiscountValueType, htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.DropDownListFor(model => model.DiscountValueType, new SelectList(Enum.GetValues(typeof(ProjectApplication.Models.DiscountValueType)), Model.DiscountValueType), new { @class = "form-control", id = "discountValueType" })
            @Html.ValidationMessageFor(model => model.DiscountValueType, "", new { @class = "text-danger" })
        </div>
    </div>

    <!-- Discount Value -->
    <div class="form-group">
        @Html.LabelFor(model => model.DiscountValue, htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-10 d-flex align-items-center">
            @Html.TextBoxFor(model => model.DiscountValue, new { @class = "form-control", id = "discountValueInput", style = "display:inline-block; width:90%;" })
            <span id="discountUnit" style="margin-left:10px; font-weight:bold;">@(Model.DiscountValueType == ProjectApplication.Models.DiscountValueType.Percent ? "%" : "₫")</span>
            @Html.ValidationMessageFor(model => model.DiscountValue, "", new { @class = "text-danger" })
        </div>
    </div>

    <!-- Coupon Code -->
    <div class="form-group" id="couponCodeField">
        @Html.LabelFor(model => model.CouponCode, htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.EditorFor(model => model.CouponCode, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.CouponCode, "", new { @class = "text-danger" })
        </div>
    </div>
    <!-- Field DiscountCondition -->
    <div id="promotionField" class="form-group">
        @Html.LabelFor(model => model.DiscountCondition, htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            <select id="discountCondition" name="DiscountCondition" class="form-control">
                <option value="Vehicle">Vehicle</option>
                <option value="SparePart">SparePart</option>
            </select>
        </div>
    </div>

    <!-- Promotion Description -->
    <div class="form-group" id="promotionDescriptionField">
        @Html.LabelFor(model => model.PromotionDescription, htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.EditorFor(model => model.PromotionDescription, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.PromotionDescription, "", new { @class = "text-danger" })
        </div>
    </div>

    <!-- Submit -->
    <div class="form-group">
        <div class="col-md-offset-2 col-md-10">
            <input type="submit" value="Lưu" class="btn btn-primary" />
            @Html.ActionLink("Quay lại", "Index", null, new { @class = "btn btn-secondary ms-2" })
        </div>
    </div>
</div>
}

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        function toggleDiscountFields() {
            var type = $("#discountType").val();
            if (type === "Coupon") {
                $("#couponCodeField").show();
                $("#promotionDescriptionField").hide();
                $("#promotionField").hide();
                $("#couponCodeField input").prop("disabled", false);
                $("#promotionDescriptionField input").prop("disabled", true);
                $("#promotionField input").prop("disabled", true);
            } else {
                $("#couponCodeField").hide();
                $("#promotionDescriptionField").show();
                $("#promotionField").show();
                $("#couponCodeField input").prop("disabled", true);
                $("#promotionDescriptionField input").prop("disabled", false);
                $("#promotionField input").prop("disabled", false);
            }
        }

        function updateDiscountUnit() {
            var valueType = $("#discountValueType").val();
            if (valueType === "Percent") {
                $("#discountUnit").text("%");
                $("#discountValueInput").attr("placeholder", "Nhập phần trăm giảm (VD: 10)");
            } else {
                $("#discountUnit").text("₫");
                $("#discountValueInput").attr("placeholder", "Nhập số tiền giảm (VD: 100000)");
            }
        }

        $(document).ready(function () {
            toggleDiscountFields();
            updateDiscountUnit();

            $("#discountType").change(toggleDiscountFields);
            $("#discountValueType").change(updateDiscountUnit);
        });
    </script>
}